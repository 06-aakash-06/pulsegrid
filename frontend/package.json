{
  "name": "pulsegrid-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK_API=true vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && VITE_DEMO_MOCK=true vite build",
    "preview": "vite preview",
    "ui:audit": "node scripts/ui-audit.mjs",
    "ui:regressions": "node scripts/ui-regressions.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@zxing/browser": "^0.2.1",
    "gsap": "^3.15.0",
    "motion": "^14.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "jsdom": "^26.1.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}

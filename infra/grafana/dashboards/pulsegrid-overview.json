    {
      "id": 7,
      "title": "Request rate by service",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsegrid-prometheus"
      },
      "description": "Real HTTP request counters, aggregated across configured replicas.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {

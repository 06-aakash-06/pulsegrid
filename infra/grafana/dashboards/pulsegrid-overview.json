              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(pulsegrid_http_requests_total{job=\"pulsegrid_api\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",

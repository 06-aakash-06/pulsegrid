{
  "annotations": {
    "list": []
  },
  "description": "Live overview of service availability, traffic, latency, Surge Mode and local alert rules.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "API readiness",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsegrid-prometheus"
      },
      "description": "Minimum readiness probe result across required service instances.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "min(probe_success{job=\"pulsegrid_readiness\"})",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Request throughput",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsegrid-prometheus"
      },
      "description": "Five-minute request rate from all discovered API instances.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(pulsegrid_http_requests_total{job=\"pulsegrid_api\"}[5m]))",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "HTTP 5xx rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsegrid-prometheus"
      },
      "description": "Observed 5xx responses divided by observed request traffic.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * sum(rate(pulsegrid_http_requests_total{job=\"pulsegrid_api\",status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(pulsegrid_http_requests_total{job=\"pulsegrid_api\"}[5m])), 0.001)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "P95 service latency",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsegrid-prometheus"
      },
      "description": "P95 estimated from the bounded HTTP duration histogram.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pulsegrid_http_request_duration_seconds_bucket{job=\"pulsegrid_api\"}[5m])))",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Surge Mode active",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsegrid-prometheus"
      },
      "description": "Appointment refreshes this shared state from the existing admission Redis control.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0

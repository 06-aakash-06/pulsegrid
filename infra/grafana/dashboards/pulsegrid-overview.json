      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsegrid-prometheus"
      },
      "description": "Prometheus alert rules currently in firing state.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0

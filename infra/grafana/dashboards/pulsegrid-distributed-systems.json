{
  "annotations": {
    "list": []
  },
  "description": "Rate limiting, cache, process-local resilience and autocomplete activity from existing service metrics.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Admission outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsegrid-prometheus"
      },
      "description": "Admission decisions from each service process; expected 429 responses remain distinct outcomes.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (owner, outcome) (rate(pulsegrid_http_admission_requests_total[5m]))",
          "refId": "A",
          "legendFormat": "{{owner}} \u00b7 {{outcome}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "title": "Cache hit ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsegrid-prometheus"
      },
      "description": "Real hit/miss observations from the distributed key-value cache.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (owner) (rate(pulsegrid_cache_requests_total{outcome=\"hit\"}[5m])) / clamp_min(sum by (owner) (rate(pulsegrid_cache_requests_total{outcome=~\"hit|miss\"}[5m])), 0.001)",
          "refId": "A",
          "legendFormat": "{{owner}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },

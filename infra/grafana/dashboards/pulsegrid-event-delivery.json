  "description": "RabbitMQ durable queue state, owner-local outbox backlogs and event delivery measurements.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Ready durable workflow messages",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsegrid-prometheus"
      },
      "description": "RabbitMQ native ready message counts for the two Appointment consumer queues.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rabbitmq_detailed_queue_messages_ready{queue=~\"pulsegrid[.]appointment[.]journey[.].*\"}",
          "refId": "A",
          "legendFormat": "{{queue}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },

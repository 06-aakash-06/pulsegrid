    {
      "id": 6,
      "title": "Publisher failures and consumer processing",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsegrid-prometheus"
      },
      "description": "Confirmed publication failures and committed consumer effects.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (owner, outcome) (rate(pulsegrid_outbox_publish_failures_total[5m])) or sum by (owner, outcome) (rate(pulsegrid_consumer_processed_total[5m]))",
          "refId": "A",
          "legendFormat": "{{owner}} \u00b7 {{outcome}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }

# Add these non-secret settings to the ignored root .env after generating keys.
# An absolute path is recommended when composing files from another checkout.
AUTH_KEYS_DIRECTORY=./secrets/auth
APP_ENVIRONMENT=development
AUTH_KID=patient-dev-1
AUTH_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8080
AUTH_ALLOW_HTTP=true
# HTTP cookies are accepted only in the explicit development environment and
# only for loopback origins. Production requires HTTPS origins, TLS, and false.

# Optional bounded settings; defaults shown.
AUTH_ACCESS_SECONDS=600
AUTH_REFRESH_IDLE_SECONDS=604800
AUTH_REFRESH_ABSOLUTE_SECONDS=2592000
AUTH_ARGON_MEMORY_KIB=65536
AUTH_ARGON_TIME_COST=3
